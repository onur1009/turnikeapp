{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/privacy.html", "destination": "https://turnikeapp.com.tr/gizlilik", "permanent": true },
    { "source": "/kvkk.html", "destination": "https://turnikeapp.com.tr/kvkk", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "duel" }], "destination": "https://turnikeapp.com.tr/duello", "permanent": false },
    { "source": "/(.*)", "destination": "https://turnikeapp.com.tr/", "permanent": true }
  ]
}
